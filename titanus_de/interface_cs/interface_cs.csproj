<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TitanusInterface</RootNamespace>
    <AssemblyName>titanus-interface</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- NativeAOT: włącza się przez `-p:PublishAot=true` (host kompiluje C# do
         natywnego ELF-a, który ładuje loader ELF w userspace OS-u). Domyślnie
         wyłączony, bo wymaga pobrania pakietu ILCompiler. -->
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
  </PropertyGroup>

</Project>
